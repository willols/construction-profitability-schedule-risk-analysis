      <aliases enabled='yes' />
      <column caption='Forecast Budget Status' datatype='string' name='[Calculation_0410241594568704]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [forecast_budget_variance] &gt; 0 THEN &quot;Overrun&quot;&#10;ELSEIF [forecast_budget_variance] = 0 THEN &quot;On-budget&quot;&#10;ELSEIF [forecast_budget_variance] &lt; 0 THEN &quot;Under-budget&quot;&#10;ELSE &quot;Unknown&quot;&#10;END' />
      </column>
      <column caption='Progress Status' datatype='string' name='[Calculation_0410241610702850]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [progress_gap_pp] &gt; 0 THEN &quot;Behind plan&quot;&#10;ELSEIF [progress_gap_pp] = 0 THEN &quot;On plan&quot;&#10;ELSEIF [progress_gap_pp] &lt; 0 THEN &quot;Ahead of plan&quot;&#10;ELSE &quot;Unknown&quot;&#10;END' />
      </column>
      <column caption='Forecast Delay Display' datatype='string' name='[Calculation_0410241613332483]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([forecast_delay_days]) THEN &quot;Unknown&quot;&#10;ELSE STR([forecast_delay_days]) + &quot; days&quot;&#10;END' />
      </column>
      <column caption='Hover Status' datatype='string' name='[Calculation_0410241744719876]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF { FIXED : MAX(&#10;    IF [Hovered Project] THEN 1 ELSE 0 END&#10;) } = 0 THEN &quot;Emphasized&quot;&#10;ELSEIF [Hovered Project] THEN &quot;Emphasized&quot;&#10;ELSE &quot;Other&quot;&#10;END' />
      </column>
      <column caption='Budget Hover Color' datatype='string' name='[Calculation_1319538056921088]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_0410241594568704] + &quot; | &quot; + [Calculation_0410241744719876]' />
      </column>
      <column caption='Progress Hover Color' datatype='string' name='[Calculation_1319538060804097]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_0410241610702850] + &quot; | &quot; + [Calculation_0410241744719876]' />
      </column>
      <column caption='Portfolio Forecast Profit Margin' datatype='real' name='[Calculation_1415882825232384]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([forecast_profit]) /&#10;SUM([revised_contract_revenue])' />
      </column>
      <column caption='Over Budget Project Flag' datatype='integer' name='[Calculation_1415882826608641]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [forecast_budget_variance] &gt; 0 THEN 1 &#10;ELSE 0 &#10;END' />
      </column>
      <column caption='Forecast Budget Variance - Exact' datatype='real' default-format='c&quot;$&quot;#,##0.00;-&quot;$&quot;#,##0.00' name='[Forecast Budget Variance (copy)_0410241600417793]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[forecast_budget_variance]' />
      </column>
